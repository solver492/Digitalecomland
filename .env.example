# Database Configuration
# PostgreSQL connection string required for Drizzle ORM
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/digitalecomland

# Server Configuration
# Port on which the API server will listen
PORT=3000

# Environment
# Set to 'development' for local development or 'production' for deployment
NODE_ENV=development
