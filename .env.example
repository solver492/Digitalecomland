# ============================================================
# Variables d'environnement — copier dans .env et remplir
# ============================================================

# --- API Server (artifacts/api-server) ---
PORT=8080
NODE_ENV=development

# Database Configuration
# PostgreSQL connection string required for Drizzle ORM
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/digitalecomland

# --- Frontend (artifacts/digital-ecom-land) ---
# PORT du serveur de développement Vite (défaut : 5173)
# PORT=5173

# Chemin de base de l'application (défaut : /)
# BASE_PATH=/