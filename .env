# ============================================================
# Variables d'environnement — copier dans .env et remplir
# ============================================================

# --- API Server (artifacts/api-server) ---
PORT=8080
NODE_ENV=development

# --- Database Configuration (Supabase PostgreSQL) ---
# IMPORTANT: Récupérez votre mot de passe sur Supabase Dashboard
DATABASE_URL=postgresql://postgres.PROJECT_ID:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Authentication ---
JWT_SECRET=dev-secret-change-in-production-use-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# --- Supabase ---
# IMPORTANT: Récupérez vos clés sur Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- Frontend (artifacts/digital-ecom-land) ---
# PORT du serveur de développement Vite (défaut : 5173)
# PORT=5173

# Chemin de base de l'application (défaut : /)
# BASE_PATH=/